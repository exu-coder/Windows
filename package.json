{
  "name": "typing-master",
  "version": "1.0.0",
  "description": "Typing Master - Build Speed. Build Accuracy. Build Muscle Memory.",
  "main": "electron/main.js",
  "author": "Typing Master",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.typingmaster.app",
    "productName": "Typing Master",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "app/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Typing Master"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Education"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  }
}
